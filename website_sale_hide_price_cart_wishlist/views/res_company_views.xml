<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_company_form_view_inherit_website_configuration" model="ir.ui.view">
        <field name="name">res.company.form.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='branches']" position="after">
                <page name="website_config" string="Website Configuration">
                    <group>
                        <group>
                            <field name="hide_website_price"/>
                            <field name="hide_cart"/>
                            <field name="pricing_number"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
